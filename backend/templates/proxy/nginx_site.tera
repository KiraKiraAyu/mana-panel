# Managed by mana-panel – Website ID: {{ website_id }}
{% if has_ssl %}
# HTTP → HTTPS redirect + ACME challenge
server {
    listen 80;
    listen [::]:80;

    server_name {{ primary_domain }}{% for alias in aliases %} {{ alias }}{% endfor %};

    location /.well-known/acme-challenge/ {
        root /opt/mana-panel/acme-challenge;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

server {
{% if has_ssl %}
    listen 443 ssl;
    listen [::]:443 ssl;

    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
{% else %}
    listen 80;
    listen [::]:80;

    # ACME challenge support (for future SSL provisioning)
    location /.well-known/acme-challenge/ {
        root /opt/mana-panel/acme-challenge;
    }
{% endif %}

    server_name {{ primary_domain }}{% for alias in aliases %} {{ alias }}{% endfor %};

{% if has_static %}
    root {{ root_dir }};
    index index.html;
{% endif %}

    location / {
{% if has_static and has_reverse_proxy %}
        try_files $uri $uri/ @proxy;
{% elif has_static %}
        try_files $uri $uri/ =404;
{% elif has_reverse_proxy %}
        proxy_pass {{ proxy_target }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% endif %}
    }

{% if has_static and has_reverse_proxy %}
    location @proxy {
        proxy_pass {{ proxy_target }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endif %}

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
